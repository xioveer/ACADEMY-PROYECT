# Copiá este archivo a ".env" y completá los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# URL del webhook de n8n que recibe y procesa el contenido (POST)
VITE_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/eduinclusiva

# URL del webhook de n8n para consultar el estado del job en modo asíncrono (GET, polling)
VITE_STATUS_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/eduinclusiva-status
