# Copiá este archivo a ".env" y completá los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# URL del webhook de n8n que recibe y procesa el contenido (POST)
VITE_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/eduinclusiva

# URL del webhook de n8n para consultar el estado del job en modo asíncrono (GET, polling)
VITE_STATUS_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/eduinclusiva-status

# Supabase — Auth (email/contraseña + Google), Database (historial y preferencias) y Storage
# (archivos originales y avatares). Si dejás estas dos vacías, la app funciona en modo demo
# con sesión e historial guardados en localStorage. Ver README.md → "Configurar Supabase".
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Google Analytics 4 — Measurement ID de tu propiedad GA4. Si la dejás vacía, no se carga
# ningún script de analítica. Ver README.md → "Configurar Google Analytics".
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
